{
  "ipv6": true,
  "tun": {
    "enable": true,
    "device": "mihomo0",
    "stack": "system",
    "auto-route": true,
    "auto-redirect": true,
    "auto-detect-interface": true,
    "strict-route": true,
    "dns-mode": "hijack",
    "dns-hijack": ["any:53", "tcp://any:53"],
    "inet6-address": ["fdfe:dcba:9876::1/126"],
    "route-exclude-address": ["192.168.0.0/24", "169.254.0.0/16", "224.0.0.0/4", "255.255.255.255/32", "fe80::/10", "ff00::/8"]
  },
  "dns": {
    "ipv6": true,
    "enhanced-mode": "fake-ip",
    "fake-ip-range": "198.18.0.1/16",
    "fake-ip-range6": "fdfe:dcba:9876::1/64",
    "fake-ip-filter": ["localhost", "+.lan", "+.local", "+.home.arpa"],
    "nameserver": ["https://1.1.1.1/dns-query#其他"],
    "default-nameserver": ["https://223.5.5.5/dns-query"],
    "proxy-server-nameserver": ["https://223.5.5.5/dns-query"],
    "nameserver-policy": {
      "+.lan": "udp://192.168.0.1:53#DIRECT",
      "+.home.arpa": "udp://192.168.0.1:53#DIRECT"
    }
  }
}

{
  "tun": {
    "enable": true,
    "device": "mihomo0",
    "stack": "system",
    "auto-route": true,
    "auto-redirect": true,
    "auto-detect-interface": true,
    "strict-route": true,
    "dns-mode": "hijack",
    "dns-hijack": ["any:53", "tcp://any:53"],
    "inet6-address": ["fdfe:dcba:9876::1/126"],
    "route-exclude-address": ["192.168.0.0/24", "169.254.0.0/16", "224.0.0.0/4", "255.255.255.255/32", "fe80::/10", "ff00::/8"]
  }
}

{
  config,
  lib,
  pkgs,
  inputs,
  ...
}:
let
  find-nix-gc-roots = (import ../packages { inherit pkgs; }).find-nix-gc-roots;
in
{
  nixpkgs.config.allowUnfree = true;
  environment.systemPackages = with pkgs; [
    cachix
    clang-tools
    cmake
    delta
    fd
    find-nix-gc-roots
    gcc
    gdb
    gh
    git
    gnupg
    jq
    kitty.terminfo
    nano
    neovim
    net-tools
    nixfmt
    nix-prefetch-scripts
    p7zip
    python3
    ripgrep
    statix
    stylua
    tree
    tree-sitter
    uv
  ];
}
